generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProfileFitnessGoal {
  FAT_LOSS    @map("fat_loss")
  MUSCLE_GAIN @map("muscle_gain")
  MAINTENANCE @map("maintenance")

  @@map("fitness_goal")
}

enum FitnessGoalType {
  FAT_LOSS    @map("fat_loss")
  MUSCLE_GAIN @map("muscle_gain")
  STRENGTH    @map("strength")

  @@map("coach_fitness_goal_type")
}

enum FitnessGoalPriority {
  KEEP_STRENGTH    @map("keep_strength")
  MAXIMUM_FAT_LOSS @map("maximum_fat_loss")
  BALANCED         @map("balanced")

  @@map("fitness_goal_priority")
}

enum FitnessGoalStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("fitness_goal_status")
}

enum CoachInsightType {
  WEIGHT    @map("weight")
  TRAINING  @map("training")
  NUTRITION @map("nutrition")
  RECOVERY  @map("recovery")

  @@map("coach_insight_type")
}

enum CoachInsightSeverity {
  NORMAL   @map("normal")
  WARNING  @map("warning")
  CRITICAL @map("critical")

  @@map("coach_insight_severity")
}

enum CoachAdjustmentRecommendationType {
  NUTRITION_CALORIES @map("nutrition_calories")
  TRAINING_RPE       @map("training_rpe")
  TRAINING_PLAN      @map("training_plan")

  @@map("coach_adjustment_recommendation_type")
}

enum TrainingPlanVersionStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("training_plan_version_status")
}

enum CoachAdjustmentStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("coach_adjustment_status")
}

enum TrainingExperience {
  BEGINNER     @map("beginner")
  INTERMEDIATE @map("intermediate")
  ADVANCED     @map("advanced")

  @@map("training_experience")
}

enum TrainingCycleStatus {
  PLANNED   @map("planned")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("training_cycle_status")
}

enum DayOfWeek {
  MONDAY    @map("monday")
  TUESDAY   @map("tuesday")
  WEDNESDAY @map("wednesday")
  THURSDAY  @map("thursday")
  FRIDAY    @map("friday")
  SATURDAY  @map("saturday")
  SUNDAY    @map("sunday")

  @@map("day_of_week")
}

enum WeightRecordType {
  MORNING @map("morning")
  EVENING @map("evening")

  @@map("weight_record_type")
}

model UserProfile {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Height in centimeters.
  heightCm            Decimal            @db.Decimal(5, 2)
  /// Current weight snapshot in kilograms; WeightRecord stores the history.
  currentWeight       Decimal            @db.Decimal(5, 2)
  goal                ProfileFitnessGoal
  trainingExperience  TrainingExperience
  weeklyTrainingDays  Int
  /// Daily energy target in kilocalories.
  dailyCaloriesTarget Int
  /// Daily protein target in grams.
  proteinTarget       Int
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  trainingCycles      TrainingCycle[]
  workoutSessions     WorkoutSession[]
  weightRecords       WeightRecord[]
  sleepRecords        SleepRecord[]
  fitnessGoals        FitnessGoal[]
  nutritionRecords    NutritionRecord[]
  dailyStatuses       DailyStatus[]
  coachInsights       CoachInsight[]
  coachAdjustments    CoachAdjustment[]

  @@map("user_profiles")
}

model TrainingCycle {
  id               String                @id @default(uuid()) @db.Uuid
  userProfileId    String                @db.Uuid
  name             String                @db.VarChar(120)
  goal             ProfileFitnessGoal
  startDate        DateTime              @db.Date
  endDate          DateTime              @db.Date
  status           TrainingCycleStatus   @default(PLANNED)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  userProfile      UserProfile           @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  planVersions     TrainingPlanVersion[]
  workoutSessions  WorkoutSession[]
  coachAdjustments CoachAdjustment[]

  @@index([userProfileId, status])
  @@index([userProfileId, startDate])
  @@map("training_cycles")
}

model TrainingPlanVersion {
  id                   String                    @id @default(uuid()) @db.Uuid
  trainingCycleId      String                    @db.Uuid
  sourceTemplateId     String?                   @db.Uuid
  versionNumber        Int
  status               TrainingPlanVersionStatus @default(ACTIVE)
  changeReason         String                    @db.Text
  createdFromVersionId String?                   @db.Uuid
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  trainingCycle        TrainingCycle             @relation(fields: [trainingCycleId], references: [id], onDelete: Cascade)
  sourceTemplate       TrainingTemplate?         @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  workoutPlans         WorkoutPlan[]
  createdFromVersion   TrainingPlanVersion?      @relation("TrainingPlanVersionHistory", fields: [createdFromVersionId], references: [id], onDelete: SetNull)
  derivedVersions      TrainingPlanVersion[]     @relation("TrainingPlanVersionHistory")

  @@unique([trainingCycleId, versionNumber])
  @@index([trainingCycleId, status])
  @@index([createdFromVersionId])
  @@index([sourceTemplateId])
  @@map("training_plan_versions")
}

model WorkoutPlan {
  id                    String              @id @default(uuid()) @db.Uuid
  trainingPlanVersionId String              @db.Uuid
  exerciseId            String?             @db.Uuid
  dayOfWeek             DayOfWeek
  category              String              @db.VarChar(50)
  exerciseName          String              @db.VarChar(150)
  sets                  Int
  reps                  Int
  /// Target load in kilograms; null supports bodyweight exercises.
  targetWeight          Decimal?            @db.Decimal(6, 2)
  targetRpe             Decimal?            @db.Decimal(3, 1)
  order                 Int
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  trainingPlanVersion   TrainingPlanVersion @relation(fields: [trainingPlanVersionId], references: [id], onDelete: Cascade)
  exercise              Exercise?           @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([trainingPlanVersionId, dayOfWeek, order])
  @@index([trainingPlanVersionId, category])
  @@index([exerciseId])
  @@map("workout_plans")
}

model Exercise {
  id                String                     @id @default(uuid()) @db.Uuid
  name              String                     @unique @db.VarChar(150)
  category          String                     @db.VarChar(50)
  muscleGroup       String                     @db.VarChar(80)
  equipment         String                     @db.VarChar(80)
  difficulty        TrainingExperience
  description       String                     @db.Text
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  workoutPlans      WorkoutPlan[]
  templateExercises TrainingTemplateExercise[]

  @@index([category, difficulty])
  @@map("exercises")
}

model TrainingTemplate {
  id                String                     @id @default(uuid()) @db.Uuid
  name              String                     @unique @db.VarChar(150)
  goal              ProfileFitnessGoal
  experience        TrainingExperience
  daysPerWeek       Int
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  templateExercises TrainingTemplateExercise[]
  generatedVersions TrainingPlanVersion[]

  @@unique([goal, experience, daysPerWeek])
  @@map("training_templates")
}

model TrainingTemplateExercise {
  id                 String           @id @default(uuid()) @db.Uuid
  trainingTemplateId String           @db.Uuid
  exerciseId         String           @db.Uuid
  dayOfWeek          DayOfWeek
  category           String           @db.VarChar(50)
  sets               Int
  reps               Int
  targetWeight       Decimal?         @db.Decimal(6, 2)
  targetRpe          Decimal?         @db.Decimal(3, 1)
  order              Int
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  trainingTemplate   TrainingTemplate @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  exercise           Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([trainingTemplateId, dayOfWeek, order])
  @@index([trainingTemplateId, dayOfWeek])
  @@index([exerciseId])
  @@map("training_template_exercises")
}

model WorkoutSession {
  id              String                  @id @default(uuid()) @db.Uuid
  userProfileId   String                  @db.Uuid
  trainingCycleId String?                 @db.Uuid
  date            DateTime                @db.Date
  category        String                  @db.VarChar(50)
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  userProfile     UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  trainingCycle   TrainingCycle?          @relation(fields: [trainingCycleId], references: [id], onDelete: SetNull)
  exerciseRecords WorkoutExerciseRecord[]

  @@index([userProfileId, date])
  @@index([trainingCycleId, date])
  @@index([category, date])
  @@map("workout_sessions")
}

model WorkoutExerciseRecord {
  id               String         @id @default(uuid()) @db.Uuid
  workoutSessionId String         @db.Uuid
  exerciseName     String         @db.VarChar(150)
  /// Actual load in kilograms; null supports bodyweight exercises.
  actualWeight     Decimal?       @db.Decimal(6, 2)
  sets             Int
  reps             Int
  rpe              Decimal?       @db.Decimal(3, 1)
  completed        Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([workoutSessionId])
  @@index([exerciseName])
  @@map("workout_exercise_records")
}

model WeightRecord {
  id            String           @id @default(uuid()) @db.Uuid
  userProfileId String           @db.Uuid
  /// Recorded weight in kilograms.
  weight        Decimal          @db.Decimal(5, 2)
  recordType    WeightRecordType
  date          DateTime         @db.Date
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  userProfile   UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date, recordType])
  @@map("weight_records")
}

model SleepRecord {
  id              String      @id @default(uuid()) @db.Uuid
  userProfileId   String      @db.Uuid
  date            DateTime    @db.Date
  /// Total sleep duration in minutes.
  durationMinutes Int
  /// Subjective sleep quality from 1 (poor) to 5 (excellent).
  quality         Int
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
  @@map("sleep_records")
}

model FitnessGoal {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  type          FitnessGoalType
  startWeight   Decimal             @db.Decimal(5, 2)
  targetWeight  Decimal             @db.Decimal(5, 2)
  targetBodyFat Decimal?            @db.Decimal(4, 1)
  startDate     DateTime            @db.Date
  targetDate    DateTime            @db.Date
  durationWeeks Int
  priority      FitnessGoalPriority
  status        FitnessGoalStatus   @default(ACTIVE)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  userProfile   UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, startDate])
  @@map("fitness_goals")
}

model NutritionRecord {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  date        DateTime    @db.Date
  calories    Int
  protein     Decimal     @db.Decimal(6, 2)
  carbs       Decimal     @db.Decimal(6, 2)
  fat         Decimal     @db.Decimal(6, 2)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("nutrition_records")
}

model DailyStatus {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  date           DateTime    @db.Date
  energyLevel    Int
  fatigueLevel   Int
  muscleSoreness Int
  stressLevel    Int
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  userProfile    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_statuses")
}

model CoachInsight {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  date        DateTime             @db.Date
  type        CoachInsightType
  severity    CoachInsightSeverity
  content     String               @db.Text
  metadata    Json
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  userProfile UserProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type, severity])
  @@map("coach_insights")
}

model CoachAdjustment {
  id                 String                            @id @default(uuid()) @db.Uuid
  userId             String                            @db.Uuid
  cycleId            String                            @db.Uuid
  recommendationType CoachAdjustmentRecommendationType
  oldValue           Json
  newValue           Json
  reason             String                            @db.Text
  status             CoachAdjustmentStatus             @default(PENDING)
  createdAt          DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                          @default(now()) @updatedAt @db.Timestamptz(3)
  userProfile        UserProfile                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingCycle      TrainingCycle                     @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([cycleId, status])
  @@map("coach_adjustments")
}
